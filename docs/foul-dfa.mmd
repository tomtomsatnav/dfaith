  [*] --> NO_RUN
  NO_RUN : NO_RUN — no test run seen yet
  TESTS_FAILING : TESTS_FAILING — tests failing
  TESTS_PASSING : TESTS_PASSING — tests passing
  TEST_EDITED : TEST_EDITED — a test was changed
  TEST_EDITED_FAILING : TEST_EDITED_FAILING — test changed, still failing
  PASSING_AFTER_EDIT : PASSING_AFTER_EDIT — green only after a test change
  CLAIMED_UNWITNESSED : CLAIMED_UNWITNESSED — claims success, no run seen
  CLAIMED_FALSE : CLAIMED_FALSE — claims success, last run failed
  CLAIMED_OK : CLAIMED_OK — claims success, tests were green
  FOUL_UNRUN : FOUL_UNRUN — FOUL  claims success after a test change, never re-ran
  FOUL_RED : FOUL_RED — FOUL  claims success after a test change, still red
  FOUL : FOUL — FOUL  claims success, green only after a test change
