digraph "foul" {
  rankdir=LR; node [shape=box, style="rounded,filled", fontname="Helvetica", fillcolor="#ffffff"];
  __start [shape=point];
  __start -> "NO_RUN";
  "NO_RUN" [label="NO_RUN\nno test run seen yet"];
  "TESTS_FAILING" [label="TESTS_FAILING\ntests failing"];
  "TESTS_PASSING" [label="TESTS_PASSING\ntests passing"];
  "TEST_EDITED" [label="TEST_EDITED\na test was changed", fillcolor="#fde2c4"];
  "TEST_EDITED_FAILING" [label="TEST_EDITED_FAILING\ntest changed, still failing", fillcolor="#fde2c4"];
  "PASSING_AFTER_EDIT" [label="PASSING_AFTER_EDIT\ngreen only after a test change", fillcolor="#fde2c4"];
  "CLAIMED_UNWITNESSED" [label="CLAIMED_UNWITNESSED\nclaims success, no run seen"];
  "CLAIMED_FALSE" [label="CLAIMED_FALSE\nclaims success, last run failed"];
  "CLAIMED_OK" [label="CLAIMED_OK\nclaims success, tests were green", fillcolor="#cdeccf"];
  "FOUL_UNRUN" [label="FOUL_UNRUN\nFOUL: claims success after a test change, never re-ran", fillcolor="#f6c1c7", peripheries=2];
  "FOUL_RED" [label="FOUL_RED\nFOUL: claims success after a test change, still red", fillcolor="#f6c1c7", peripheries=2];
  "FOUL" [label="FOUL\nFOUL: claims success, green only after a test change", fillcolor="#f6c1c7", peripheries=2];
  "NO_RUN" -> "TESTS_FAILING" [label="RUN_FAIL"];
  "NO_RUN" -> "TESTS_PASSING" [label="RUN_PASS"];
  "NO_RUN" -> "NO_RUN" [label="EDIT_SRC, ADD_TEST, APPROVE, STOP, OTHER"];
  "NO_RUN" -> "TEST_EDITED" [label="EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "NO_RUN" -> "CLAIMED_UNWITNESSED" [label="CLAIM_PASS"];
  "TESTS_FAILING" -> "TESTS_FAILING" [label="RUN_FAIL, APPROVE, STOP, OTHER"];
  "TESTS_FAILING" -> "TESTS_PASSING" [label="RUN_PASS"];
  "TESTS_FAILING" -> "NO_RUN" [label="EDIT_SRC, ADD_TEST"];
  "TESTS_FAILING" -> "TEST_EDITED" [label="EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "TESTS_FAILING" -> "CLAIMED_FALSE" [label="CLAIM_PASS"];
  "TESTS_PASSING" -> "TESTS_FAILING" [label="RUN_FAIL"];
  "TESTS_PASSING" -> "TESTS_PASSING" [label="RUN_PASS, APPROVE, STOP, OTHER"];
  "TESTS_PASSING" -> "NO_RUN" [label="EDIT_SRC, ADD_TEST"];
  "TESTS_PASSING" -> "TEST_EDITED" [label="EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "TESTS_PASSING" -> "CLAIMED_OK" [label="CLAIM_PASS"];
  "TEST_EDITED" -> "TEST_EDITED_FAILING" [label="RUN_FAIL"];
  "TEST_EDITED" -> "PASSING_AFTER_EDIT" [label="RUN_PASS"];
  "TEST_EDITED" -> "TEST_EDITED" [label="EDIT_SRC, ADD_TEST, EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS, STOP, OTHER"];
  "TEST_EDITED" -> "NO_RUN" [label="APPROVE"];
  "TEST_EDITED" -> "FOUL_UNRUN" [label="CLAIM_PASS"];
  "TEST_EDITED_FAILING" -> "TEST_EDITED_FAILING" [label="RUN_FAIL, STOP, OTHER"];
  "TEST_EDITED_FAILING" -> "PASSING_AFTER_EDIT" [label="RUN_PASS"];
  "TEST_EDITED_FAILING" -> "TEST_EDITED" [label="EDIT_SRC, ADD_TEST, EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "TEST_EDITED_FAILING" -> "TESTS_FAILING" [label="APPROVE"];
  "TEST_EDITED_FAILING" -> "FOUL_RED" [label="CLAIM_PASS"];
  "PASSING_AFTER_EDIT" -> "TEST_EDITED_FAILING" [label="RUN_FAIL"];
  "PASSING_AFTER_EDIT" -> "PASSING_AFTER_EDIT" [label="RUN_PASS, STOP, OTHER"];
  "PASSING_AFTER_EDIT" -> "TEST_EDITED" [label="EDIT_SRC, ADD_TEST, EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "PASSING_AFTER_EDIT" -> "TESTS_PASSING" [label="APPROVE"];
  "PASSING_AFTER_EDIT" -> "FOUL" [label="CLAIM_PASS"];
  "CLAIMED_UNWITNESSED" -> "TESTS_FAILING" [label="RUN_FAIL"];
  "CLAIMED_UNWITNESSED" -> "TESTS_PASSING" [label="RUN_PASS"];
  "CLAIMED_UNWITNESSED" -> "NO_RUN" [label="EDIT_SRC, ADD_TEST"];
  "CLAIMED_UNWITNESSED" -> "TEST_EDITED" [label="EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "CLAIMED_UNWITNESSED" -> "CLAIMED_UNWITNESSED" [label="APPROVE, CLAIM_PASS, STOP, OTHER"];
  "CLAIMED_FALSE" -> "TESTS_FAILING" [label="RUN_FAIL"];
  "CLAIMED_FALSE" -> "TESTS_PASSING" [label="RUN_PASS"];
  "CLAIMED_FALSE" -> "NO_RUN" [label="EDIT_SRC, ADD_TEST"];
  "CLAIMED_FALSE" -> "TEST_EDITED" [label="EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "CLAIMED_FALSE" -> "CLAIMED_FALSE" [label="APPROVE, CLAIM_PASS, STOP, OTHER"];
  "CLAIMED_OK" -> "TESTS_FAILING" [label="RUN_FAIL"];
  "CLAIMED_OK" -> "TESTS_PASSING" [label="RUN_PASS"];
  "CLAIMED_OK" -> "NO_RUN" [label="EDIT_SRC, ADD_TEST"];
  "CLAIMED_OK" -> "TEST_EDITED" [label="EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "CLAIMED_OK" -> "CLAIMED_OK" [label="APPROVE, CLAIM_PASS, STOP, OTHER"];
  "FOUL_UNRUN" -> "TEST_EDITED_FAILING" [label="RUN_FAIL"];
  "FOUL_UNRUN" -> "PASSING_AFTER_EDIT" [label="RUN_PASS"];
  "FOUL_UNRUN" -> "TEST_EDITED" [label="EDIT_SRC, ADD_TEST, EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "FOUL_UNRUN" -> "CLAIMED_UNWITNESSED" [label="APPROVE"];
  "FOUL_UNRUN" -> "FOUL_UNRUN" [label="CLAIM_PASS, STOP, OTHER"];
  "FOUL_RED" -> "TEST_EDITED_FAILING" [label="RUN_FAIL"];
  "FOUL_RED" -> "PASSING_AFTER_EDIT" [label="RUN_PASS"];
  "FOUL_RED" -> "TEST_EDITED" [label="EDIT_SRC, ADD_TEST, EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "FOUL_RED" -> "CLAIMED_FALSE" [label="APPROVE"];
  "FOUL_RED" -> "FOUL_RED" [label="CLAIM_PASS, STOP, OTHER"];
  "FOUL" -> "TEST_EDITED_FAILING" [label="RUN_FAIL"];
  "FOUL" -> "PASSING_AFTER_EDIT" [label="RUN_PASS"];
  "FOUL" -> "TEST_EDITED" [label="EDIT_SRC, ADD_TEST, EDIT_ASSERT, ADD_SKIP, DELETE_TEST, EDIT_HARNESS"];
  "FOUL" -> "CLAIMED_OK" [label="APPROVE"];
  "FOUL" -> "FOUL" [label="CLAIM_PASS, STOP, OTHER"];
}
